APP_ENV=development
DATABASE_BACKEND=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lead_generator
DATABASE_ECHO=false
JWT_SECRET=replace-with-a-strong-local-secret
SECRET_ENCRYPTION_KEY=replace-with-a-strong-encryption-key
JOB_QUEUE=default
ENABLE_LEGACY_RUNTIME=false
APP_API_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://127.0.0.1:8501
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/settings/providers/gmail/oauth/callback
ADMIN_TENANT_ID=mian755
ADMIN_TENANT_NAME="Admin Tenant"
ADMIN_TENANT_SLUG=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FULL_NAME="Admin User"
ADMIN_PLAN=Agency
PAYMENT_ACCOUNT_TITLE=replace_me
PAYMENT_ACCOUNT_NUMBER=replace_me
PAYMENT_METHOD_NAME=JazzCash/EasyPaisa/Bank Transfer
PAYMENT_CURRENCY=PKR
PAYMENT_QR_PATH=assets/payment-qr.jpeg
PAYMENT_QR_PATH_PRO=assets/payment-qr-pro.jpeg
PAYMENT_QR_PATH_AGENCY=assets/payment-qr-agency.jpeg
BILLING_PRICE_PRO_PKR=2800
BILLING_PRICE_AGENCY_PKR=5000

# Lead Generation Demo Mode
# LEADGEN_DEMO_MODE=true is only for demos/contact-only mode.
# When true: accepts any lead with real scraped email/phone (junk sources still rejected).
# When false (production): requires relevance_passed AND real email/phone.
# Default must be false for production.
LEADGEN_DEMO_MODE=false
